/target

# Local debug configuration, not part of the tree.
/*.cfg

# Python tooling is a local venv (see .agents/skills/python-tools).
# venv writes its own `venv/.gitignore` (a lone `*`), but keep the entry here as
# well: the ignore must not depend on what generated the directory.
/venv/

# Firmware build (root Makefile): the working config and both build trees.
# `firmware.config` is the committed seed and stays tracked.
/.config
/.config.old
/out/

# The packaged Mainsail site embedded into the binary (see build.rs): the
# contents of Mainsail's dist/ are put here for a release build, not committed.
/assets/mainsail/

# Scratch area for logs and run artifacts moved out of /tmp (never committed).
/.staging/

src/core/klippy/upstream_generated/cases/
src/core/klippy/upstream_generated/fixtures/
src/core/klippy/upstream_generated/mod.rs
